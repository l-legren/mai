{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "format:check": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["format:check"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["typecheck"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["typecheck", "lint", "format:check"]
    },
    "//#test": {
      "outputs": [],
      "dependsOn": ["//#format:check"]
    },
    "eval": {
      "outputs": [],
      "dependsOn": ["typecheck"],
      "cache": false,
      "env": ["ANTHROPIC_API_KEY", "LMNR_PROJECT_API_KEY"]
    }
  }
}
