# Point this .env.local at a dev/staging Supabase project, never the production one — Attack
# Protection (captcha), email-confirmation, and redirect-URL settings are project-wide in Supabase,
# so testing against the prod project changes real behavior for real users, not just yours.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public) — the matching secret key lives only in Supabase's
# dashboard (Authentication > Attack Protection), never in this codebase. Once the dev project
# above is separate from prod, its Attack Protection secret can safely use Cloudflare's published
# test keypair (sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA —
# always passes, no real scoring) instead of a real one, since it no longer affects prod traffic.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# agent service on railway — read server-side only (app/api/ask-mai/route.ts), never NEXT_PUBLIC_:
# the browser only ever talks to our own same-origin proxy route, not the agent service directly.
RAILWAY_AGENT_SERVICE_URL=https://mai-agent-staging.up.railway.app
