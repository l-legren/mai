# Local dev secrets for Supabase Edge Functions.
# Copy this file to .env.local (gitignored via supabase/.gitignore) and fill in your real key.
# Used with: supabase functions serve --env-file supabase/functions/.env.local
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Direct Postgres connection as the `mcp_readonly` role (supabase/roles.sql), used by ask-moniq's
# tool `execute` bodies via agent/src/db.ts. Local dev value matches roles.sql's placeholder
# password once `supabase start` is running.
MCP_READONLY_DATABASE_URL=postgresql://mcp_readonly:mcp_readonly_local_dev_only@127.0.0.1:54322/postgres

# SUPABASE_URL and SUPABASE_ANON_KEY are auto-injected by the Supabase platform/CLI into every
# Edge Function — no entry needed here or in `supabase secrets set`.
