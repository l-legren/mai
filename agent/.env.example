# Copy to `.env` (gitignored) and fill in.
#
# Only needed for running `pnpm eval` locally — the Supabase Edge Function
# (supabase/functions/generate-spending-summary) gets its own copy via
# `supabase secrets set ANTHROPIC_API_KEY=...`, a separate secret store that
# only applies when Deno actually runs that function. This one is for plain
# local/CI Node processes (this eval script), which don't inherit that.
ANTHROPIC_API_KEY=

# This key is scoped to the org, not a workspace, so requests must carry the workspace id via the
# anthropic-workspace-id header (see src/run.ts) or Anthropic rejects them. Find it in the
# Anthropic Console under the workspace's settings.
ANTHROPIC_WORKSPACE_ID=

# Laminar (tracing/evals). This is the SDK's own conventional name. Laminar.initialize() in
# src/observability.ts reads it; unset locally just disables tracing, doesn't fail the server.
LMNR_PROJECT_API_KEY=

# Direct Postgres connection as the `mcp_readonly` role (supabase/roles.sql), used by
# src/db.ts's withScopedRead. Only needed for scripts that exercise the real tool `execute` bodies
# locally — the `ask-mai` Edge Function gets its own copy via `supabase secrets set`.
# Local dev, once `supabase start` is running: matches supabase/roles.sql's placeholder password.
#
# On Cloud Run (or any host without IPv6 egress): the project's direct `db.<ref>.supabase.co:5432`
# host resolves IPv6-only, so a plain copy of the hosted project's direct connection string here
# fails with ENETUNREACH. Use Supabase's connection pooler (Supavisor) host instead —
# `aws-0-<region>.pooler.supabase.com:6543` (transaction mode) — which is IPv4-reachable. Same fix
# already applied on the web side for this project's Postgres connections.
MCP_READONLY_DATABASE_URL=postgresql://mcp_readonly:mcp_readonly_local_dev_only@127.0.0.1:54322/postgres

# Same as above, as the `mcp_write` role — used by src/db.ts's withScopedWrite (e.g. rememberFact).
MCP_WRITE_DATABASE_URL=postgresql://mcp_write:mcp_write_local_dev_only@127.0.0.1:54322/postgres

# LEG-170: as the `mcp_langgraph` role, used by LangGraph's PostgresSaver/PostgresStore
# (src/scripts/langgraph-*.ts, src/experiments/*). Deliberately the Supavisor **session-mode**
# pooler port (5432 on the pooler host), not the transaction-mode port 6543 used above — LangGraph's
# Postgres clients rely on prepared statements, which transaction-mode pooling can silently break
# (a prepared statement lives on one underlying connection; transaction mode may hand your next
# query to a different one, which has never heard of it). Session mode keeps one dedicated
# connection for the process's lifetime, same IPv4 reachability Cloud Run needs. On the hosted
# project, the pooler username must be `mcp_langgraph.<project_ref>`, not just `mcp_langgraph`.
LANGGRAPH_DATABASE_URL=postgresql://mcp_langgraph:mcp_langgraph_local_dev_only@127.0.0.1:54322/postgres

# One-time-use only, needed once to run `pnpm langgraph:setup` (it runs CREATE ROLE/CREATE TABLE,
# which `mcp_langgraph` deliberately can't do). Same Supavisor session-mode pooler host as
# LANGGRAPH_DATABASE_URL below — same IPv4-reachability reason as MCP_READONLY_DATABASE_URL's note
# above — but connecting as this project's owner role (`postgres.<project_ref>` as the pooler
# username) instead of `mcp_langgraph.<project_ref>`. Never commit a real value — fill in locally
# for that one run, then clear it.
LANGGRAPH_SETUP_DATABASE_URL=

# One-time-use only, read by the same `pnpm langgraph:setup` run: a password you choose for the new
# mcp_langgraph role on the hosted project (the script creates the role if it doesn't exist yet).
# Clear it after that one run, same as LANGGRAPH_SETUP_DATABASE_URL above.
LANGGRAPH_ROLE_PASSWORD=

# Embeddings for semantic memory search (src/memory/embeddings.ts) — a new vendor relationship,
# since Anthropic has no embeddings endpoint. text-embedding-3-small, 1536 dims.
OPENAI_API_KEY=