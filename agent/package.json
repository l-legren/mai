{
  "name": "@mai/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  },
  "main": "src/server.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "eval": "npx lmnr eval",
    "start:dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "langgraph:setup": "tsx src/scripts/langgraph-setup.ts",
    "langgraph:verify-write": "tsx src/scripts/langgraph-checkpoint-verify.ts write",
    "langgraph:verify-read": "tsx src/scripts/langgraph-checkpoint-verify.ts read",
    "langgraph:clear-memory": "tsx src/scripts/langgraph-clear-memory.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@hono/node-server": "^2.1.5",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.150",
    "chalk": "^6.0.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "postgres": "^3.4.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@lmnr-ai/lmnr": "^0.8.51",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "babel-jest": "~29.7.0",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
