{
  "name": "@moniq/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  },
  "main": "src/server.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "npx lmnr eval",
    "start:dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.114.0",
    "ai": "^7.0.91",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.5",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@lmnr-ai/lmnr": "^0.8.45",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
