{
  "name": "mai-mono",
  "packageManager": "pnpm@11.5.1",
  "prettier": "@mai/config/prettier.json",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@mai/config": "workspace:*",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10"
  },
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:start": "pnpm --dir apps/web start",
    "web:test": "pnpm --dir apps/web test",
    "start": "pnpm --dir apps/mobile start",
    "android": "pnpm --dir apps/mobile android",
    "ios": "pnpm --dir apps/mobile ios",
    "build:android": "pnpm --dir apps/mobile build:android",
    "build:ios": "pnpm --dir apps/mobile build:ios",
    "test:watch": "pnpm --dir apps/mobile test:watch",
    "smoke": "pnpm --dir apps/mobile smoke",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/mobile/**/*.{js,jsx,ts,tsx}": [
      "pnpm --dir apps/mobile exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "packages/api/**/*.{js,ts}": [
      "pnpm --dir packages/api exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "packages/schemas/**/*.{js,ts}": [
      "pnpm --dir packages/schemas exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "packages/config/**/*.mjs": [
      "pnpm --dir packages/config exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "agent/**/*.{js,ts}": [
      "pnpm --dir agent exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "pnpm --dir apps/web exec eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
